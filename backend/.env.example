# NeuroStock Backend Configuration (copy to backend/.env for local development)

# Runtime environment: development | test | production
APP_ENV=development

# Network binding (keep 127.0.0.1 for local dev; use reverse proxy TLS in production)
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Firebase Authentication (fail-closed in production)
AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=your-firebase-project-id

# Strict CORS allowlist (comma-separated origins; '*' is rejected in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & hardening flags
VERIFY_MODEL_INTEGRITY=true
ENABLE_API_DOCS=false
ENABLE_HSTS=false
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=262144

# Local LLM (LM Studio) & FinBERT settings
LM_STUDIO_API_URL=http://127.0.0.1:1234/v1/chat/completions
ALLOW_REMOTE_LLM_URL=false
LOCAL_MODEL_NAME=google/gemma-4-26b-a4b
FINBERT_MODEL_NAME=ProsusAI/finbert
